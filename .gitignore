/dist/

# Locally staged third-party tool binaries (libewf, Sleuth Kit, ffmpeg).
# These are deployed per-workstation, never committed. The pinned tool
# manifest (versions, URLs, SHA-256) is versioned.
/tools/*
!/tools/manifest.json
!/tools/*.requirements.txt
# Hash-pinned license texts FrameTrace ships (manifest bundled/package_licenses).
!/tools/licenses/
